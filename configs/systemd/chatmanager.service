[Unit]
Description=Chat Manager (ChatShare local)
After=network.target network-online.target
Wants=network-online.target

[Service]
Type=simple
WorkingDirectory=/home/darkseid/chatshare
ExecStart=/home/darkseid/chatshare/.venv/bin/python -m uvicorn src.main:app --host 0.0.0.0 --port 9095
Restart=on-failure
RestartSec=5
StandardOutput=journal
StandardError=journal

[Install]
WantedBy=default.target
